# Copy to .env and fill in values. Do not commit .env.

# Retrieval
# Leave PAGEINDEX_API_KEY and PAGEINDEX_DOC_ID empty to use the deterministic
# local fallback (required for a reproducible run without external services).
PAGEINDEX_API_KEY=
PAGEINDEX_DOC_ID=

# Used by PageIndex local/cloud mode if you enable the PageIndex backend.
OPENAI_API_KEY=

# LLM
# Leave LLM_PROVIDER empty to use the stub provider (no network).
# Examples: stub, openai, openai-compatible
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

