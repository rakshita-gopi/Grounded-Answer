# Copy to .env and fill in values. Do not commit .env.

# Retrieval
# Leave PAGEINDEX_API_KEY and PAGEINDEX_DOC_ID empty to use local retrieval.
PAGEINDEX_API_KEY=
PAGEINDEX_DOC_ID=

# Ollama embeddings (official model: https://ollama.com/library/qwen3-embedding)
# For local Python + local Ollama:
OLLAMA_BASE_URL=http://localhost:11434
# Docker Compose overrides this to http://ollama:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_TIMEOUT_SECONDS=120
# Optional query instruction. Use {query} as the placeholder.
# OLLAMA_QUERY_INSTRUCTION=Instruct: Given a policy question, retrieve the most relevant policy provisions that directly support the answer.\nQuery: {query}

# Set to lexical to force the Stage A term-overlap retriever.
# RETRIEVAL_BACKEND=lexical

# LLM
# Docker Compose sets LLM_PROVIDER=ollama and LLM_MODEL=qwen3:4b.
# Tests pass an empty environ and keep using the stub provider.
# Leave LLM_PROVIDER empty (or stub) for the stub generator without Ollama chat.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
LLM_NUM_PREDICT=60
OLLAMA_LLM_TIMEOUT_SECONDS=300
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
